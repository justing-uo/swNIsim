Package: swNIsim
Type: Package
Title: Stepped-Wedge Non-Inferiority Simulation
Version: 1.3
Authors@R: c(
    person(
      given = "Justin",
      family = "Guo",
      role = c("aut", "cre"),
      email = "justinyguo@gmail.com"
